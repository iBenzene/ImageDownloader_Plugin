{
    "name": "benben-image-downloader-plugin",
    "version": "0.4.1",
    "description": "《苯苯存图》浏览器插件",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "lint": "eslint --config eslint.config.cjs . && stylelint \"**/*.{css,scss,less}\" --allow-empty-input",
        "lint:fix": "eslint --config eslint.config.cjs . --fix && stylelint \"**/*.{css,scss,less}\" --fix --allow-empty-input",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
        "fix": "npm run lint:fix && npm run format",
        "prepare": "node -e \"try { require.resolve('husky') } catch { process.exit(0) } import('husky').then(m => m.default())\"",
        "precommit": "lint-staged --concurrent false"
    },
    "author": "iBenzene",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.10.0",
        "esbuild": "^0.24.0",
        "happy-dom": "^21.0.4",
        "tsx": "^4.19.2",
        "typescript": "~6.0.3",
        "@eslint/js": "^10.0.1",
        "@prettier/plugin-pug": "^3.6.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.4.2",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "postcss-less": "^6.0.0",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.10",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-less": "^4.1.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.2",
        "stylelint-prettier": "^5.0.3",
        "vue-eslint-parser": "^10.4.1"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
